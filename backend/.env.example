# ─── Copy this file to .env and fill in your values ───────────────────────────

# Project URL (same as frontend): required when Auth uses ES256 / JWT Signing Keys
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Full Postgres URI from Supabase (Database → Connection string → URI).
# Must include scheme, user, password, host, port, database — not the host alone.
# Session pooler example:
# postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@[POOLER-HOST]:6543/postgres

# HS256 only: JWT Secret from Settings → API (not needed if tokens are ES256 when SUPABASE_URL + JWKS are used)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Gemini API Key (free at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
